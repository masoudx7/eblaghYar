{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|2169995\\.txt$).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/web/reconcile",
      "schedule": "0 3 * * *"
    }
  ]
}
