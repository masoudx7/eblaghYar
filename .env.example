# ==========================================
# EblaghYar Environment Variables Template
# Copy to .env locally or configure in Vercel Project Settings.
# NEVER expose server secrets with VITE_ prefix.
# ==========================================

# Server runtime environment ("development" locally, "production" on Vercel web)
NODE_ENV="development"
PORT=3000

# Google Gemini API Key (server-side only, used by /api/analyze and /api/web/analyze)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase Project URL
# IMPORTANT: Web deployment (https://tahlil-yar.ir) uses a SEPARATE Supabase project from Android!
SUPABASE_URL=""

# Supabase Service Role Key (SECRET - server-side only, never expose to client bundle)
SUPABASE_SERVICE_ROLE_KEY=""

# Supabase Anon/Public Key (used server-side in /api/web/auth/* routes; never sent to browser)
SUPABASE_ANON_KEY=""

# Public Base URL of the web deployment (set to https://tahlil-yar.ir on Web Vercel project)
# AI Studio injects this automatically in preview environments.
APP_URL="MY_APP_URL"

# 36-char Zarinpal Merchant UUID (required for /api/web/payment/*)
ZARINPAL_MERCHANT_ID=""

# Set to "true" ONLY on Web Vercel project (tahlil-yar.ir) to disable legacy payment routes (403).
# Keep "false" for Android backend / preview so legacy & Bazaar flows remain intact.
DISABLE_LEGACY_PAYMENT="false"

# Set to "true" ONLY on Web Vercel project (tahlil-yar.ir) to enforce paid /api/web/analyze and block free /api/analyze (403).
# Keep "false" for Android backend / preview so /api/analyze & devices quota remain unchanged.
WEB_ONLY="false"

# Optional client API base URL (leave empty on same-origin Vercel web; set only for Capacitor/Android builds)
VITE_API_BASE_URL=""
